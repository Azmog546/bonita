      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.stage && $data.stage_sujet && $data.convention && $data.convention_stage && $data.convention_stage_sujet ){",
        "\t//attach lazy references variables to parent variables",
        "\t$data.stage.sujet = $data.stage_sujet;",
        "\t$data.convention.stage = $data.convention_stage;",
        "\t$data.convention.stage.sujet = $data.convention_stage_sujet;",
        "\treturn {",
        "\t\t//map stage variable to expected task contract input",
        "\t\tstageInput: {",
        "\t\t\tdateDebut: $data.stage.dateDebut !== undefined ? $data.stage.dateDebut : null,",
        "\t\t\tdateFin: $data.stage.dateFin !== undefined ? $data.stage.dateFin : null",
        "\t\t},",
        "\t\t//map convention variable to expected task contract input",
        "\t\tconventionInput: {",
        "\t\t\tstage: $data.convention.stage ? {",
        "\t\t\t\tpersistenceId_string: $data.convention.stage.persistenceId_string !== undefined ? $data.convention.stage.persistenceId_string : null",
        "\t\t\t} : null",
        "\t\t}",
        "\t}",
        "}"
      ],
