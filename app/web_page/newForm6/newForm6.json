    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.sujet_choix ){",
        "\treturn {",
        "\t\t//map sujet_choix variable to expected task contract input",
        "\t\tsujet_choixInput: {",
        "\t\t\ttitre: $data.sujet_choix.titre !== undefined ? $data.sujet_choix.titre : null,",
        "\t\t\tdescription: $data.sujet_choix.description !== undefined ? $data.sujet_choix.description : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
