      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.convention && $data.convention_stage ){",
        "\t//attach lazy references variables to parent variables",
        "\t$data.convention.stage = $data.convention_stage;",
        "\treturn {",
        "\t\t//map convention variable to expected task contract input",
        "\t\tconventionInput: {",
        "\t\t\tsignatureDoyen: $data.convention.signatureDoyen !== undefined ? $data.convention.signatureDoyen : null",
